# Copy to .env — never commit .env

APP_ENV=dev
API_PREFIX=/api

# Gemini (Google AI Studio) — optional if you use OpenRouter instead
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (OpenAI-compatible). Use this if you do not have a Google key.
# Model stays Gemini Flash via OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Local LLM fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral

# Models (see docs/decisions.md)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVE_K=10
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.25
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Chat auth + rate limit (Phase 5). Leave API_KEY empty for local pytest.
# Compose / shared demo: set a random string and send it as header X-API-Key.
API_KEY=
RATE_LIMIT_PER_MINUTE=20

# Host ports for Compose. Change these if 8000 or 5173 are already taken.
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
